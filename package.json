{
  "name": "baps-hospitality-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:setup": "prisma db push && prisma db seed",
    "user:upsert": "tsx scripts/upsert-user.ts",
    "dev:lightsail": "dotenv -e .env.lightsail -- next dev",
    "db:push:lightsail": "dotenv -e .env.lightsail -- prisma db push",
    "db:seed:lightsail": "dotenv -e .env.lightsail -v SEED_MOCK_DATA=false -- prisma db seed",
    "db:studio:lightsail": "dotenv -e .env.lightsail -- prisma studio",
    "dev:console": "dotenv -v OTP_PROVIDER=console -- next dev",
    "notify": "tsx scripts/notify.ts",
    "sant:demo": "tsx scripts/seed-sant-demo.ts",
    "sant:utaro": "tsx scripts/sant-utaro.ts",
    "hotel:liaisons": "tsx scripts/hotel-liaisons.ts",
    "hotel:liaisons:lightsail": "dotenv -e .env.lightsail -- tsx scripts/hotel-liaisons.ts",
    "hotlines": "tsx scripts/hotlines.ts",
    "hotlines:lightsail": "dotenv -e .env.lightsail -- tsx scripts/hotlines.ts",
    "breakouts:sync": "tsx scripts/sync-breakouts.ts",
    "breakouts:sync:lightsail": "dotenv -e .env.lightsail -- tsx scripts/sync-breakouts.ts",
    "sant:schedule:sync": "tsx scripts/sync-sant-schedule.ts",
    "sant:schedule:sync:lightsail": "dotenv -e .env.lightsail -- tsx scripts/sync-sant-schedule.ts",
    "sant:menu:sync": "tsx scripts/sync-sant-menu.ts",
    "sant:menu:sync:lightsail": "dotenv -e .env.lightsail -- tsx scripts/sync-sant-menu.ts",
    "sant:personal:sync": "tsx scripts/sync-sant-personal.ts",
    "sant:personal:sync:lightsail": "dotenv -e .env.lightsail -- tsx scripts/sync-sant-personal.ts",
    "santos:import": "tsx scripts/import-santos.ts",
    "santos:import:lightsail": "dotenv -e .env.lightsail -- tsx scripts/import-santos.ts",
    "delegates:import": "tsx scripts/import-delegates.ts",
    "delegates:import:lightsail": "dotenv -e .env.lightsail -- tsx scripts/import-delegates.ts",
    "transport:import": "tsx scripts/import-transport.ts",
    "transport:import:lightsail": "dotenv -e .env.lightsail -- tsx scripts/import-transport.ts",
    "rooming:import": "tsx scripts/import-rooming.ts",
    "rooming:import:lightsail": "dotenv -e .env.lightsail -- tsx scripts/import-rooming.ts",
    "venue:import": "tsx --tsconfig scripts/tsconfig.server-only.json scripts/import-venue.ts",
    "venue:import:lightsail": "dotenv -e .env.lightsail -- tsx --tsconfig scripts/tsconfig.server-only.json scripts/import-venue.ts",
    "testers:personas": "tsx scripts/tester-personas.ts",
    "testers:personas:lightsail": "dotenv -e .env.lightsail -- tsx scripts/tester-personas.ts",
    "ses:bounces": "tsx scripts/ses-bounces.ts",
    "ses:bounces:lightsail": "dotenv -e .env.lightsail -- tsx scripts/ses-bounces.ts",
    "deploy:vercel": "node scripts/deploy-vercel.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.700.0",
    "@aws-sdk/client-sns": "^3.700.0",
    "@prisma/client": "^6.16.0",
    "jose": "^6.0.0",
    "lucide-react": "^0.544.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "dotenv-cli": "^8.0.0",
    "exceljs": "^4.4.0",
    "postcss": "^8.5.0",
    "prisma": "^6.16.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
